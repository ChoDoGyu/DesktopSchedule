<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DesktopSchedule.Controls">

    <Style x:Key="ScheduleCalendarDayButtonStyle"
           TargetType="{x:Type CalendarDayButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1" />
    </Style>

    <Style x:Key="ScheduleCalendarButtonStyle"
           TargetType="{x:Type CalendarButton}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinWidth" Value="54" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style x:Key="ScheduleCalendarStyle"
           TargetType="{x:Type Calendar}">
        <Setter Property="Width" Value="320" />
        <Setter Property="Height" Value="300" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ScheduleCalendarDayButtonStyle}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource ScheduleCalendarButtonStyle}" />
    </Style>

    <Style TargetType="{x:Type controls:ScheduleDatePicker}">
        <Setter Property="CalendarStyle" Value="{StaticResource ScheduleCalendarStyle}" />
    </Style>

</ResourceDictionary>