<UserControl x:Class="DesktopSchedule.Controls.ScheduleTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <Grid>
        <Button x:Name="OpenButton"
                Click="OpenButton_Click"
                Padding="6"
                HorizontalContentAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DisplayTextBlock"
                           Grid.Column="0"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="▼"
                           FontSize="9"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </Grid>
        </Button>

        <Popup x:Name="TimePopup"
               PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom"
               VerticalOffset="2"
               StaysOpen="False"
               AllowsTransparency="True"
               Closed="TimePopup_Closed">

            <Border Background="White"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="시간"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />

                        <TextBlock Grid.Column="2"
                                   Text="분"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="HourTextBox"
                                 Grid.Column="0"
                                 MaxLength="2"
                                 FontSize="18"
                                 TextAlignment="Center"
                                 Padding="6"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 GotKeyboardFocus="NumericTextBox_GotKeyboardFocus"
                                 LostKeyboardFocus="HourTextBox_LostKeyboardFocus"
                                 PreviewMouseWheel="HourTextBox_PreviewMouseWheel"
                                 PreviewKeyDown="TimeTextBox_PreviewKeyDown" />

                        <TextBlock Grid.Column="1"
                                   Text=":"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <TextBox x:Name="MinuteTextBox"
                                 Grid.Column="2"
                                 MaxLength="2"
                                 FontSize="18"
                                 TextAlignment="Center"
                                 Padding="6"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 GotKeyboardFocus="NumericTextBox_GotKeyboardFocus"
                                 LostKeyboardFocus="MinuteTextBox_LostKeyboardFocus"
                                 PreviewMouseWheel="MinuteTextBox_PreviewMouseWheel"
                                 PreviewKeyDown="TimeTextBox_PreviewKeyDown" />
                    </Grid>

                    <TextBlock Text="마우스 휠로 1씩 조절"
                               FontSize="11"
                               Foreground="DimGray"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>