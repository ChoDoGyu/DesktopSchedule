<UserControl x:Class="DesktopSchedule.Views.WeeklyScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DesktopSchedule.Controls"
             xmlns:views="clr-namespace:DesktopSchedule.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="WeeklyDayHeaderButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AppButtonBaseStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                </Trigger>

                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ScheduleBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>

                    <Setter Property="Background" Value="{StaticResource ScheduleBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </MultiDataTrigger>

                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DropTargetBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DropTargetBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WeeklyDayBodyStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ScheduleBorderBrush}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DropTargetBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DropTargetBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="DragSurface"
          PreviewMouseMove="DragSurface_PreviewMouseMove"
          PreviewMouseLeftButtonUp="DragSurface_PreviewMouseLeftButtonUp"
          PreviewKeyDown="DragSurface_PreviewKeyDown"
          LostMouseCapture="DragSurface_LostMouseCapture">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Content="완료 일정 보기"
                          IsChecked="{Binding ShowCompletedSchedules}"
                          Style="{StaticResource AppCheckBoxStyle}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Button Content="‹"
                            Command="{Binding PreviousWeekCommand}"
                            Style="{StaticResource AppNavigationButtonStyle}"
                            Margin="0,0,8,0" />

                    <TextBlock Text="{Binding WeekRangeText}"
                               Style="{StaticResource AppDisplayTitleTextStyle}"
                               Width="230"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />

                    <Button Content="›"
                            Command="{Binding NextWeekCommand}"
                            Style="{StaticResource AppNavigationButtonStyle}"
                            Margin="8,0,0,0" />

                    <Button Content="이번 주"
                            Command="{Binding CurrentWeekCommand}"
                            Style="{StaticResource AppSecondaryButtonStyle}"
                            Margin="8,0,0,0" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="새 일정"
                        Command="{Binding OpenNewScheduleCommand}"
                        Style="{StaticResource AppPrimaryButtonStyle}"
                        HorizontalAlignment="Right" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Stretch">

                        <Grid x:Name="WeekCalendarArea"
                              MinHeight="380"
                              HorizontalAlignment="Stretch">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ItemsControl Grid.Row="0"
                                          ItemsSource="{Binding Days}"
                                          HorizontalContentAlignment="Stretch">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenNewScheduleForDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource WeeklyDayHeaderButtonStyle}">

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">

                                                <TextBlock Text="{Binding DayName}" />

                                                <TextBlock Text="{Binding DayText}"
                                                           Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Row="1"
                                  MinHeight="338">

                                <ItemsControl ItemsSource="{Binding Days}"
                                              Panel.ZIndex="0"
                                              IsHitTestVisible="False"
                                              HorizontalContentAlignment="Stretch">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource WeeklyDayBodyStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding SpanningSchedules}"
                                              Height="{Binding SpanningAreaHeight}"
                                              VerticalAlignment="Top"
                                              HorizontalContentAlignment="Stretch"
                                              Panel.ZIndex="2">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:CalendarSchedulePanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource AppScheduleCardButtonStyle}"
                                                    ToolTip="{Binding ToolTipText}"
                                                    PreviewMouseLeftButtonDown="ScheduleButton_PreviewMouseLeftButtonDown">

                                                <TextBlock Text="{Binding DisplayText}"
                                                           Style="{StaticResource AppScheduleCardTextStyle}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Border Style="{StaticResource AppPanelBorderStyle}"
                        MinWidth="480"
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <views:ScheduleEditorView />
                </Border>
            </Grid>
        </Grid>

        <Canvas IsHitTestVisible="False"
                Panel.ZIndex="1000">

            <controls:ScheduleDragPreview x:Name="DragPreview" />
        </Canvas>
    </Grid>
</UserControl>