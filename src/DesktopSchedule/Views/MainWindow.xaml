<Window x:Class="DesktopSchedule.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopSchedule.ViewModels"
        xmlns:views="clr-namespace:DesktopSchedule.Views"
        xmlns:services="clr-namespace:DesktopSchedule.Services"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="{x:Static services:WindowPlacementService.DefaultWidth}"
        Height="{x:Static services:WindowPlacementService.DefaultHeight}"
        MinWidth="900"
        MinHeight="800"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        ShowInTaskbar="{Binding ShowInTaskbar, Mode=OneWay}"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MonthlyCalendarViewModel}">
            <views:MonthlyCalendarView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WeeklyScheduleViewModel}">
            <views:WeeklyScheduleView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DailyViewModel}">
            <views:DailyView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <Style x:Key="MainNavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AppSecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="6,0,0,0" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       Style="{StaticResource AppPageTitleTextStyle}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="월간"
                        Command="{Binding ShowMonthlyCalendarCommand}"
                        Tag="{Binding IsMonthlyViewActive}"
                        Style="{StaticResource MainNavigationButtonStyle}"
                        Margin="0" />

                <Button Content="주간"
                        Command="{Binding ShowWeeklyScheduleCommand}"
                        Tag="{Binding IsWeeklyViewActive}"
                        Style="{StaticResource MainNavigationButtonStyle}" />

                <Button Content="일간"
                        Command="{Binding ShowDailyCommand}"
                        Tag="{Binding IsDailyViewActive}"
                        Style="{StaticResource MainNavigationButtonStyle}" />

                <Button Content="설정"
                        Command="{Binding ShowSettingsCommand}"
                        Tag="{Binding IsSettingsViewActive}"
                        Style="{StaticResource MainNavigationButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource AppPanelBorderStyle}">

            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>