<UserControl x:Class="DesktopSchedule.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <StackPanel Margin="16">
        <TextBlock Text="설정"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20" />

        <Border BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">

            <StackPanel>
                <TextBlock Text="Windows"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <CheckBox Content="Windows 시작 시 DesktopSchedule 자동 실행"
                          IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}"
                          Margin="0,0,0,8" />

                <TextBlock Text="Windows에 로그인하면 DesktopSchedule을 자동으로 실행합니다."
                           Foreground="DimGray"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="24,0,0,0" />

                <TextBlock Text="{Binding StartupErrorMessage}"
                           Foreground="DarkRed"
                           TextWrapping="Wrap"
                           Margin="24,8,0,0" />
            </StackPanel>
        </Border>

        <Border BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">

            <StackPanel>
                <TextBlock Text="창"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <CheckBox Content="항상 위에 표시"
                          IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                          Margin="0,0,0,8" />

                <TextBlock Text="DesktopSchedule을 다른 프로그램 창보다 항상 위에 표시합니다."
                           Foreground="DimGray"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="24,0,0,16" />

                <CheckBox Content="작업 표시줄에 표시"
                          IsChecked="{Binding ShowInTaskbar, Mode=TwoWay}"
                          Margin="0,0,0,8" />

                <TextBlock Text="끄더라도 시스템 트레이 아이콘은 유지되며 트레이에서 다시 열 수 있습니다."
                           Foreground="DimGray"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="24,0,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>