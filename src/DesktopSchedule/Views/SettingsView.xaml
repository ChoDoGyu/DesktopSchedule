<UserControl x:Class="DesktopSchedule.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="SettingsSectionTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppSectionTitleTextStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SettingsDescriptionTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppSecondaryTextStyle}">
            <Setter Property="Margin" Value="24,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsErrorTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppSecondaryTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="24,8,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="16">
            <TextBlock Text="설정"
                       Style="{StaticResource AppPageTitleTextStyle}"
                       Margin="0,0,0,20" />

            <Border Style="{StaticResource AppPanelBorderStyle}"
                    Margin="0,0,0,12">

                <StackPanel>
                    <TextBlock Text="Windows"
                               Style="{StaticResource SettingsSectionTitleStyle}" />

                    <CheckBox Content="Windows 시작 시 DesktopSchedule 자동 실행"
                              IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}"
                              Style="{StaticResource AppCheckBoxStyle}" />

                    <TextBlock Text="Windows에 로그인하면 DesktopSchedule을 자동으로 실행합니다."
                               Style="{StaticResource SettingsDescriptionTextStyle}" />

                    <TextBlock Text="{Binding StartupErrorMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource SettingsErrorTextStyle}">
                                <Setter Property="Visibility" Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StartupErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding StartupErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppPanelBorderStyle}"
                    Margin="0,0,0,12">

                <StackPanel>
                    <TextBlock Text="창"
                               Style="{StaticResource SettingsSectionTitleStyle}" />

                    <CheckBox Content="항상 위에 표시"
                              IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                              Style="{StaticResource AppCheckBoxStyle}" />

                    <TextBlock Text="DesktopSchedule을 다른 프로그램 창보다 항상 위에 표시합니다."
                               Style="{StaticResource SettingsDescriptionTextStyle}"
                               Margin="24,4,0,16" />

                    <CheckBox Content="작업 표시줄에 표시"
                              IsChecked="{Binding ShowInTaskbar, Mode=TwoWay}"
                              Style="{StaticResource AppCheckBoxStyle}" />

                    <TextBlock Text="끄더라도 시스템 트레이 아이콘은 유지되며 트레이에서 다시 열 수 있습니다."
                               Style="{StaticResource SettingsDescriptionTextStyle}" />

                    <TextBlock Text="{Binding AppSettingsErrorMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource SettingsErrorTextStyle}">
                                <Setter Property="Visibility" Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppSettingsErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding AppSettingsErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppPanelBorderStyle}">

                <StackPanel>
                    <TextBlock Text="초기화"
                               Style="{StaticResource SettingsSectionTitleStyle}" />

                    <Button Content="앱 표시 설정 기본값으로 초기화"
                            Command="{Binding ResetSettingsCommand}"
                            Style="{StaticResource AppSecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10" />

                    <TextBlock Text="항상 위와 작업 표시줄 설정, 창 위치와 크기를 기본값으로 되돌립니다. Windows 시작 프로그램 설정과 일정 데이터는 유지됩니다."
                               Style="{StaticResource AppSecondaryTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>