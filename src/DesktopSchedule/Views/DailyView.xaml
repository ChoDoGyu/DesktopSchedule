<UserControl x:Class="DesktopSchedule.Views.DailyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DesktopSchedule.Controls"
             xmlns:views="clr-namespace:DesktopSchedule.Views"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DailyPanelBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource AppPanelBorderStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="DailyScheduleButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ScheduleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ScheduleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="1" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </Trigger>

                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CompletedBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CompletedBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource CompletedTextBrush}" />
                    <Setter Property="Opacity" Value="0.72" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DailyListButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ScheduleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ScheduleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </Trigger>

                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CompletedBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CompletedBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource CompletedTextBrush}" />
                    <Setter Property="Opacity" Value="0.72" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="DragSurface"
          Focusable="True"
          PreviewMouseMove="DragSurface_PreviewMouseMove"
          PreviewMouseLeftButtonUp="DragSurface_PreviewMouseLeftButtonUp"
          PreviewKeyDown="DragSurface_PreviewKeyDown"
          LostMouseCapture="DragSurface_LostMouseCapture">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button Content="‹"
                        Command="{Binding PreviousDayCommand}"
                        Style="{StaticResource AppNavigationButtonStyle}"
                        Margin="0,0,8,0" />

                <TextBlock Text="{Binding SelectedDateText}"
                           Style="{StaticResource AppDisplayTitleTextStyle}"
                           MinWidth="250"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />

                <Button Content="›"
                        Command="{Binding NextDayCommand}"
                        Style="{StaticResource AppNavigationButtonStyle}"
                        Margin="8,0,0,0" />

                <Button Content="오늘"
                        Command="{Binding TodayCommand}"
                        Style="{StaticResource AppSecondaryButtonStyle}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource DailyPanelBorderStyle}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="16,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="시간 일정"
                                       Style="{StaticResource AppSectionTitleTextStyle}"
                                       VerticalAlignment="Center" />

                            <CheckBox Grid.Column="1"
                                      Content="완료 일정 보기"
                                      IsChecked="{Binding ShowCompletedSchedules}"
                                      Style="{StaticResource AppCheckBoxStyle}"
                                      VerticalAlignment="Center" />

                            <Button Grid.Column="3"
                                    Content="새 일정"
                                    Command="{Binding OpenNewScheduleCommand}"
                                    Style="{StaticResource AppPrimaryButtonStyle}" />
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="12,0,12,12"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">

                                <Grid x:Name="DailyTimelineArea"
                                      Background="{StaticResource SurfaceBrush}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top">

                                    <controls:DailyTimelineGrid x:Name="TimelineGrid"
                                                                VerticalAlignment="Top"
                                                                Panel.ZIndex="0" />

                                    <Border x:Name="DropTargetHighlight"
                                            Margin="52,0,8,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Background="#E6F4EA"
                                            BorderBrush="#66A879"
                                            BorderThickness="1"
                                            Opacity="0.72"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"
                                            Panel.ZIndex="5" />

                                    <ItemsControl ItemsSource="{Binding TimedSchedules}"
                                                  Height="{Binding ElementName=TimelineGrid, Path=ActualHeight}"
                                                  Margin="52,0,8,0"
                                                  VerticalAlignment="Top"
                                                  HorizontalContentAlignment="Stretch"
                                                  Panel.ZIndex="10">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:DailySchedulePanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button PreviewMouseLeftButtonDown="ScheduleButton_PreviewMouseLeftButtonDown"
                                                        Style="{StaticResource DailyScheduleButtonStyle}"
                                                        ToolTip="{Binding ToolTipText}">

                                                    <TextBlock Text="{Binding DisplayText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="IncompleteScheduleArea"
                            Grid.Row="0"
                            Background="Transparent"
                            Style="{StaticResource DailyPanelBorderStyle}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="16,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="할 일"
                                           Style="{StaticResource AppSectionTitleTextStyle}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="아래로 드래그하면 완료"
                                           Style="{StaticResource AppCaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="12,0,12,12">

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">

                                    <ItemsControl x:Name="IncompleteScheduleItemsControl"
                                                  ItemsSource="{Binding IncompleteSchedules}"
                                                  HorizontalContentAlignment="Stretch">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button PreviewMouseLeftButtonDown="ScheduleListButton_PreviewMouseLeftButtonDown"
                                                        Style="{StaticResource DailyListButtonStyle}"
                                                        ToolTip="{Binding ToolTipText}">

                                                    <TextBlock Text="{Binding DisplayText}"
                                                               HorizontalAlignment="Left"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="할 일이 없습니다."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource AppSecondaryTextStyle}">
                                            <Setter Property="Visibility" Value="Visible" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=IncompleteScheduleItemsControl, Path=HasItems}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="CompletedScheduleArea"
                            Grid.Row="2"
                            Background="Transparent"
                            Style="{StaticResource DailyPanelBorderStyle}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="16,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="완료한 일"
                                           Style="{StaticResource AppSectionTitleTextStyle}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="위로 드래그하면 완료 취소"
                                           Style="{StaticResource AppCaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="12,0,12,12">

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">

                                    <ItemsControl x:Name="CompletedScheduleItemsControl"
                                                  ItemsSource="{Binding CompletedSchedules}"
                                                  HorizontalContentAlignment="Stretch">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button PreviewMouseLeftButtonDown="ScheduleListButton_PreviewMouseLeftButtonDown"
                                                        Style="{StaticResource DailyListButtonStyle}"
                                                        ToolTip="{Binding ToolTipText}">

                                                    <TextBlock Text="{Binding DisplayText}"
                                                               HorizontalAlignment="Left"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="완료한 일이 없습니다."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource AppSecondaryTextStyle}">
                                            <Setter Property="Visibility" Value="Visible" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=CompletedScheduleItemsControl, Path=HasItems}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Style="{StaticResource AppPanelBorderStyle}"
                    MinWidth="480"
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

                <views:ScheduleEditorView />
            </Border>
        </Grid>

        <Canvas Grid.Row="0"
                Grid.RowSpan="3"
                IsHitTestVisible="False"
                Panel.ZIndex="1000">

            <controls:ScheduleDragPreview x:Name="DragPreview" />
        </Canvas>
    </Grid>
</UserControl>