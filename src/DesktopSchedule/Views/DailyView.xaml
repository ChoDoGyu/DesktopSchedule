<UserControl x:Class="DesktopSchedule.Views.DailyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DesktopSchedule.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid x:Name="DragSurface"
          Focusable="True"
          PreviewMouseMove="DragSurface_PreviewMouseMove"
          PreviewMouseLeftButtonUp="DragSurface_PreviewMouseLeftButtonUp"
          PreviewKeyDown="DragSurface_PreviewKeyDown"
          LostMouseCapture="DragSurface_LostMouseCapture">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="&lt;"
                        Command="{Binding PreviousDayCommand}"
                        Width="38"
                        Height="30" />

                <TextBlock Text="{Binding SelectedDateText}"
                           MinWidth="220"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold" />

                <Button Content="오늘"
                        Command="{Binding TodayCommand}"
                        Margin="0,0,12,0"
                        Padding="12,5" />

                <Button Content="&gt;"
                        Command="{Binding NextDayCommand}"
                        Width="38"
                        Height="30" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility"
                                Value="Visible" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="#D8D8D8"
                        BorderThickness="1"
                        CornerRadius="6">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="12,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="시간 일정"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <CheckBox Grid.Column="1"
                                      Content="완료 일정 보기"
                                      IsChecked="{Binding ShowCompletedSchedules}"
                                      VerticalAlignment="Center" />

                            <Button Grid.Column="3"
                                    Content="+ 일정"
                                    Command="{Binding OpenNewScheduleCommand}"
                                    Padding="12,5" />
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="10,0,10,10"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">

                                <Grid x:Name="DailyTimelineArea"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top">

                                    <controls:DailyTimelineGrid x:Name="TimelineGrid"
                                                                VerticalAlignment="Top"
                                                                Panel.ZIndex="0" />

                                    <Border x:Name="DropTargetHighlight"
                                            Margin="52,0,8,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Background="AliceBlue"
                                            BorderBrush="#8CB8F0"
                                            BorderThickness="1"
                                            Opacity="0.65"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"
                                            Panel.ZIndex="5" />

                                    <ItemsControl ItemsSource="{Binding TimedSchedules}"
                                                  Height="{Binding ElementName=TimelineGrid, Path=ActualHeight}"
                                                  Margin="52,0,8,0"
                                                  VerticalAlignment="Top"
                                                  HorizontalContentAlignment="Stretch"
                                                  Panel.ZIndex="10">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:DailySchedulePanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Button PreviewMouseLeftButtonDown="ScheduleButton_PreviewMouseLeftButtonDown"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Center"
                                                        BorderThickness="1"
                                                        Padding="5,1"
                                                        ToolTip="{Binding ToolTipText}">

                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background"
                                                                    Value="#DCEBFF" />
                                                            <Setter Property="BorderBrush"
                                                                    Value="#8CB8F0" />
                                                            <Setter Property="Opacity"
                                                                    Value="1" />

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#E7E7E7" />
                                                                    <Setter Property="BorderBrush"
                                                                            Value="#BDBDBD" />
                                                                    <Setter Property="Opacity"
                                                                            Value="0.58" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>

                                                    <TextBlock Text="{Binding DisplayText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="#202020" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="#666666" />
                                                                        <Setter Property="TextDecorations"
                                                                                Value="Strikethrough" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="IncompleteScheduleArea"
                            Grid.Row="0"
                            Background="Transparent"
                            BorderBrush="#D8D8D8"
                            BorderThickness="1"
                            CornerRadius="6">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="12,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="할 일"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="아래로 드래그하면 완료"
                                           FontSize="11"
                                           Foreground="#888888"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="10,0,10,10">

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">

                                    <ItemsControl x:Name="IncompleteScheduleItemsControl"
                                                  ItemsSource="{Binding IncompleteSchedules}"
                                                  HorizontalContentAlignment="Stretch">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Button PreviewMouseLeftButtonDown="ScheduleListButton_PreviewMouseLeftButtonDown"
                                                        HorizontalContentAlignment="Stretch"
                                                        HorizontalAlignment="Stretch"
                                                        Padding="6,4"
                                                        Margin="0,0,0,4"
                                                        Background="#DCEBFF"
                                                        BorderBrush="#8CB8F0"
                                                        BorderThickness="1"
                                                        ToolTip="{Binding ToolTipText}">

                                                    <TextBlock Text="{Binding DisplayText}"
                                                               HorizontalAlignment="Left"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Button>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="할 일이 없습니다."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#888888"
                                           IsHitTestVisible="False">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=IncompleteScheduleItemsControl, Path=HasItems}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="CompletedScheduleArea"
                            Grid.Row="2"
                            Background="Transparent"
                            BorderBrush="#D8D8D8"
                            BorderThickness="1"
                            CornerRadius="6">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="12,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="완료한 일"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="위로 드래그하면 완료 취소"
                                           FontSize="11"
                                           Foreground="#888888"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="10,0,10,10">

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">

                                    <ItemsControl x:Name="CompletedScheduleItemsControl"
                                                  ItemsSource="{Binding CompletedSchedules}"
                                                  HorizontalContentAlignment="Stretch">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Button PreviewMouseLeftButtonDown="ScheduleListButton_PreviewMouseLeftButtonDown"
                                                        HorizontalContentAlignment="Stretch"
                                                        HorizontalAlignment="Stretch"
                                                        Padding="6,4"
                                                        Margin="0,0,0,4"
                                                        Background="#E7E7E7"
                                                        BorderBrush="#BDBDBD"
                                                        BorderThickness="1"
                                                        Opacity="0.65"
                                                        ToolTip="{Binding ToolTipText}">

                                                    <TextBlock Text="{Binding DisplayText}"
                                                               HorizontalAlignment="Left"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#666666"
                                                               TextDecorations="Strikethrough"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Button>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="완료한 일이 없습니다."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#888888"
                                           IsHitTestVisible="False">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=CompletedScheduleItemsControl, Path=HasItems}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    MinWidth="480"
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="{Binding EditorTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="제목"
                                   Margin="0,0,0,4" />

                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6"
                                 Margin="0,0,0,10" />

                        <TextBlock Text="설명"
                                   Margin="0,0,0,4" />

                        <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Height="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6"
                                 Margin="0,0,0,10" />

                        <TextBlock Text="시작"
                                   Margin="0,0,0,4" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <controls:ScheduleDatePicker Grid.Column="0"
                                                         SelectedDate="{Binding NewStartDate}" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding NewStartTime, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6" />
                        </Grid>

                        <TextBlock Text="종료"
                                   Margin="0,0,0,4" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <controls:ScheduleDatePicker Grid.Column="0"
                                                         SelectedDate="{Binding NewEndDate}" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding NewEndTime, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6" />
                        </Grid>

                        <CheckBox Content="하루 종일"
                                  IsChecked="{Binding NewIsAllDay}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="알림 사용"
                                  IsChecked="{Binding NewIsReminderEnabled}"
                                  Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">

                            <ComboBox ItemsSource="{Binding ReminderMinuteOptions}"
                                      SelectedItem="{Binding NewReminderMinutesBefore}"
                                      IsEnabled="{Binding NewIsReminderEnabled}"
                                      Width="100" />

                            <TextBlock Text="분 전 알림"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <WrapPanel HorizontalAlignment="Right">

                            <Button Content="완료"
                                    Command="{Binding MarkAsCompletedCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEditMode}"
                                                               Value="True" />
                                                    <Condition Binding="{Binding IsEditingCompleted}"
                                                               Value="False" />
                                                </MultiDataTrigger.Conditions>

                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="완료 취소"
                                    Command="{Binding MarkAsIncompleteCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEditMode}"
                                                               Value="True" />
                                                    <Condition Binding="{Binding IsEditingCompleted}"
                                                               Value="True" />
                                                </MultiDataTrigger.Conditions>

                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="삭제"
                                    Command="{Binding DeleteScheduleCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="취소"
                                    Command="{Binding CancelEditCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0" />

                            <Button Content="저장"
                                    Command="{Binding SaveScheduleCommand}"
                                    Padding="12,6" />

                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Canvas Grid.Row="0"
                Grid.RowSpan="3"
                IsHitTestVisible="False"
                Panel.ZIndex="1000">

            <controls:ScheduleDragPreview x:Name="DragPreview" />
        </Canvas>
    </Grid>
</UserControl>