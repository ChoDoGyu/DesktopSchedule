<UserControl x:Class="DesktopSchedule.Views.ScheduleEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DesktopSchedule.Controls"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="560">

    <UserControl.Resources>
        <Style x:Key="EditorFieldLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppBodyTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="EditorSectionTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource AppSectionTitleTextStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel>
            <TextBlock Text="{Binding EditorTitle}"
                       Style="{StaticResource AppDisplayTitleTextStyle}"
                       Margin="0,0,0,20" />

            <TextBlock Text="기본 정보"
                       Style="{StaticResource EditorSectionTitleStyle}" />

            <TextBlock Text="제목"
                       Style="{StaticResource EditorFieldLabelStyle}" />

            <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource AppTextBoxStyle}"
                     Margin="0,0,0,14" />

            <TextBlock Text="설명"
                       Style="{StaticResource EditorFieldLabelStyle}" />

            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource AppTextBoxStyle}"
                     Height="84"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,20" />

            <Border BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,0,0,20" />

            <TextBlock Text="일정"
                       Style="{StaticResource EditorSectionTitleStyle}" />

            <TextBlock Text="시작"
                       Style="{StaticResource EditorFieldLabelStyle}" />

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <controls:ScheduleDatePicker Grid.Column="0"
                                             SelectedDate="{Binding NewStartDate}" />

                <controls:ScheduleTimePicker Grid.Column="2"
                                             Text="{Binding NewStartTime, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <TextBlock Text="종료"
                       Style="{StaticResource EditorFieldLabelStyle}" />

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <controls:ScheduleDatePicker Grid.Column="0"
                                             SelectedDate="{Binding NewEndDate}" />

                <controls:ScheduleTimePicker Grid.Column="2"
                                             Text="{Binding NewEndTime, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <CheckBox Content="하루 종일"
                      IsChecked="{Binding NewIsAllDay}"
                      Style="{StaticResource AppCheckBoxStyle}"
                      Margin="0,0,0,20" />

            <Border BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,0,0,20" />

            <TextBlock Text="알림"
                       Style="{StaticResource EditorSectionTitleStyle}" />

            <CheckBox Content="알림 사용"
                      IsChecked="{Binding NewIsReminderEnabled}"
                      Style="{StaticResource AppCheckBoxStyle}"
                      Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,18">

                <ComboBox ItemsSource="{Binding ReminderMinuteOptions}"
                          SelectedItem="{Binding NewReminderMinutesBefore}"
                          IsEnabled="{Binding NewIsReminderEnabled}"
                          Style="{StaticResource AppComboBoxStyle}"
                          Width="110" />

                <TextBlock Text="분 전 알림"
                           Style="{StaticResource AppBodyTextStyle}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,0,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           HorizontalAlignment="Left">

                    <Button Content="완료"
                            Command="{Binding MarkAsCompletedCommand}"
                            Margin="0,0,8,0">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource AppSecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEditMode}"
                                                       Value="True" />

                                            <Condition Binding="{Binding IsEditingCompleted}"
                                                       Value="False" />
                                        </MultiDataTrigger.Conditions>

                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="완료 취소"
                            Command="{Binding MarkAsIncompleteCommand}"
                            Margin="0,0,8,0">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource AppSecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEditMode}"
                                                       Value="True" />

                                            <Condition Binding="{Binding IsEditingCompleted}"
                                                       Value="True" />
                                        </MultiDataTrigger.Conditions>

                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="삭제"
                            Command="{Binding DeleteScheduleCommand}">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource AppDestructiveButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="취소"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource AppSecondaryButtonStyle}"
                            Margin="0,0,8,0" />

                    <Button Content="저장"
                            Command="{Binding SaveScheduleCommand}"
                            Style="{StaticResource AppPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>