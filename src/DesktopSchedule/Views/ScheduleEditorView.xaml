<UserControl x:Class="DesktopSchedule.Views.ScheduleEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DesktopSchedule.Controls"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="560">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel>
            <TextBlock Text="{Binding EditorTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <TextBlock Text="제목"
                       Margin="0,0,0,4" />

            <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6"
                     Margin="0,0,0,10" />

            <TextBlock Text="설명"
                       Margin="0,0,0,4" />

            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                     Height="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="6"
                     Margin="0,0,0,10" />

            <TextBlock Text="시작"
                       Margin="0,0,0,4" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>

                <controls:ScheduleDatePicker Grid.Column="0"
                                             SelectedDate="{Binding NewStartDate}" />

                <TextBox Grid.Column="2"
                         Text="{Binding NewStartTime, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6" />
            </Grid>

            <TextBlock Text="종료"
                       Margin="0,0,0,4" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>

                <controls:ScheduleDatePicker Grid.Column="0"
                                             SelectedDate="{Binding NewEndDate}" />

                <TextBox Grid.Column="2"
                         Text="{Binding NewEndTime, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6" />
            </Grid>

            <CheckBox Content="하루 종일"
                      IsChecked="{Binding NewIsAllDay}"
                      Margin="0,0,0,10" />

            <CheckBox Content="알림 사용"
                      IsChecked="{Binding NewIsReminderEnabled}"
                      Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">

                <ComboBox ItemsSource="{Binding ReminderMinuteOptions}"
                          SelectedItem="{Binding NewReminderMinutesBefore}"
                          IsEnabled="{Binding NewIsReminderEnabled}"
                          Width="100" />

                <TextBlock Text="분 전 알림"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <WrapPanel HorizontalAlignment="Right">

                <Button Content="완료"
                        Command="{Binding MarkAsCompletedCommand}"
                        Padding="12,6"
                        Margin="0,0,6,0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />

                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEditMode}"
                                                   Value="True" />

                                        <Condition Binding="{Binding IsEditingCompleted}"
                                                   Value="False" />
                                    </MultiDataTrigger.Conditions>

                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="완료 취소"
                        Command="{Binding MarkAsIncompleteCommand}"
                        Padding="12,6"
                        Margin="0,0,6,0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />

                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEditMode}"
                                                   Value="True" />

                                        <Condition Binding="{Binding IsEditingCompleted}"
                                                   Value="True" />
                                    </MultiDataTrigger.Conditions>

                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="삭제"
                        Command="{Binding DeleteScheduleCommand}"
                        Padding="12,6"
                        Margin="0,0,6,0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}"
                                             Value="True">

                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="취소"
                        Command="{Binding CancelEditCommand}"
                        Padding="12,6"
                        Margin="0,0,6,0" />

                <Button Content="저장"
                        Command="{Binding SaveScheduleCommand}"
                        Padding="12,6" />

            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>