<UserControl x:Class="DesktopSchedule.Views.MonthlyCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DesktopSchedule.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      Content="완료 일정 보기"
                      IsChecked="{Binding ShowCompletedSchedules}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="‹"
                        Command="{Binding PreviousMonthCommand}"
                        Width="38"
                        Height="32"
                        FontSize="18"
                        Margin="0,0,8,0" />

                <TextBlock Text="{Binding DisplayMonthText}"
                           Width="140"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center" />

                <Button Content="오늘"
                        Command="{Binding CurrentMonthCommand}"
                        Padding="12,6"
                        Margin="8,0" />

                <Button Content="›"
                        Command="{Binding NextMonthCommand}"
                        Width="38"
                        Height="32"
                        FontSize="18" />
            </StackPanel>

            <Button Grid.Column="2"
                    Content="새 일정"
                    Command="{Binding OpenNewScheduleCommand}"
                    HorizontalAlignment="Right"
                    Padding="14,7" />
        </Grid>

        <UniformGrid Grid.Row="1"
                     Rows="1"
                     Columns="7"
                     Margin="0,0,0,4">

            <Border BorderBrush="#D8D8D8"
                    BorderThickness="1"
                    Padding="8,6">
                <TextBlock Text="일"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#D45454" />
            </Border>

            <Border BorderBrush="#D8D8D8"
                    BorderThickness="1"
                    Padding="8,6">
                <TextBlock Text="월"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
            </Border>

            <Border BorderBrush="#D8D8D8"
                    BorderThickness="1"
                    Padding="8,6">
                <TextBlock Text="화"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
            </Border>

            <Border BorderBrush="#D8D8D8"
                    BorderThickness="1"
                    Padding="8,6">
                <TextBlock Text="수"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
            </Border>

            <Border BorderBrush="#D8D8D8"
                    BorderThickness="1"
                    Padding="8,6">
                <TextBlock Text="목"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
            </Border>

            <Border BorderBrush="#D8D8D8"
                    BorderThickness="1"
                    Padding="8,6">
                <TextBlock Text="금"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
            </Border>

            <Border BorderBrush="#D8D8D8"
                    BorderThickness="1"
                    Padding="8,6">
                <TextBlock Text="토"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#4D72C9" />
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility"
                                Value="Visible" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding Weeks}"
                                  HorizontalContentAlignment="Stretch">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Grid MinHeight="112">

                                    <ItemsControl ItemsSource="{Binding Days}"
                                                  HorizontalContentAlignment="Stretch">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"
                                                             Columns="7" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Border BorderBrush="#D8D8D8"
                                                        BorderThickness="1"
                                                        MinHeight="112"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="CalendarDay_MouseLeftButtonUp">

                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="White" />
                                                            <Setter Property="BorderBrush"
                                                                    Value="#D8D8D8" />
                                                            <Setter Property="BorderThickness"
                                                                    Value="1" />
                                                            <Setter Property="Opacity"
                                                                    Value="1" />

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentMonth}"
                                                                             Value="False">
                                                                    <Setter Property="Background"
                                                                            Value="#F5F5F5" />
                                                                    <Setter Property="Opacity"
                                                                            Value="0.62" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding IsSelected}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#EAF3FF" />
                                                                    <Setter Property="Opacity"
                                                                            Value="1" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding IsToday}"
                                                                             Value="True">
                                                                    <Setter Property="BorderBrush"
                                                                            Value="#4A90E2" />
                                                                    <Setter Property="BorderThickness"
                                                                            Value="2" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding IsDropTarget}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#D7F0E2" />
                                                                    <Setter Property="BorderBrush"
                                                                            Value="#56A675" />
                                                                    <Setter Property="BorderThickness"
                                                                            Value="2" />
                                                                    <Setter Property="Opacity"
                                                                            Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="28" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding DayText}"
                                                                   Margin="6,4"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right">

                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="#333333" />

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSunday}"
                                                                                     Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="#D45454" />
                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding IsSaturday}"
                                                                                     Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="#4D72C9" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Grid Grid.Row="1"
                                                              Height="{Binding DataContext.SpanningAreaHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />

                                                        <ItemsControl Grid.Row="2"
                                                                      ItemsSource="{Binding Schedules}"
                                                                      Margin="3,2,3,4">

                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>

                                                                    <Border BorderThickness="1"
                                                                            CornerRadius="3"
                                                                            Padding="4,2"
                                                                            Margin="0,0,0,2"
                                                                            ToolTip="{Binding ToolTipText}"
                                                                            Cursor="Hand"
                                                                            MouseLeftButtonUp="Schedule_MouseLeftButtonUp">

                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background"
                                                                                        Value="#F2F6FA" />
                                                                                <Setter Property="BorderBrush"
                                                                                        Value="#CEDAE6" />
                                                                                <Setter Property="Opacity"
                                                                                        Value="1" />

                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCompleted}"
                                                                                                 Value="True">
                                                                                        <Setter Property="Background"
                                                                                                Value="#EEEEEE" />
                                                                                        <Setter Property="BorderBrush"
                                                                                                Value="#CCCCCC" />
                                                                                        <Setter Property="Opacity"
                                                                                                Value="0.58" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>

                                                                        <TextBlock Text="{Binding DisplayText}"
                                                                                   FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   TextWrapping="NoWrap">

                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground"
                                                                                            Value="#202020" />

                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCompleted}"
                                                                                                     Value="True">
                                                                                            <Setter Property="Foreground"
                                                                                                    Value="#666666" />
                                                                                            <Setter Property="TextDecorations"
                                                                                                    Value="Strikethrough" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding SpanningSchedules}"
                                                  Height="{Binding SpanningAreaHeight}"
                                                  Margin="0,28,0,0"
                                                  VerticalAlignment="Top"
                                                  Panel.ZIndex="10">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:MonthlySpanningSchedulePanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Border BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="5,2"
                                                        ToolTip="{Binding ToolTipText}"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="Schedule_MouseLeftButtonUp">

                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="#DCEBFF" />
                                                            <Setter Property="BorderBrush"
                                                                    Value="#8CB8F0" />
                                                            <Setter Property="Opacity"
                                                                    Value="1" />

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#E7E7E7" />
                                                                    <Setter Property="BorderBrush"
                                                                            Value="#BDBDBD" />
                                                                    <Setter Property="Opacity"
                                                                            Value="0.58" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Text="{Binding DisplayText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap">

                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="#202020" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="#666666" />
                                                                        <Setter Property="TextDecorations"
                                                                                Value="Strikethrough" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    MinWidth="480"
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="제목"
                                   Margin="0,0,0,4" />

                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6"
                                 Margin="0,0,0,10" />

                        <TextBlock Text="설명"
                                   Margin="0,0,0,4" />

                        <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Height="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6"
                                 Margin="0,0,0,10" />

                        <TextBlock Text="시작"
                                   Margin="0,0,0,4" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <controls:ScheduleDatePicker Grid.Column="0"
                                                         SelectedDate="{Binding NewStartDate}" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding NewStartTime, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6" />
                        </Grid>

                        <TextBlock Text="종료"
                                   Margin="0,0,0,4" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <controls:ScheduleDatePicker Grid.Column="0"
                                                         SelectedDate="{Binding NewEndDate}" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding NewEndTime, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6" />
                        </Grid>

                        <CheckBox Content="하루 종일"
                                  IsChecked="{Binding NewIsAllDay}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="알림 사용"
                                  IsChecked="{Binding NewIsReminderEnabled}"
                                  Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">

                            <ComboBox ItemsSource="{Binding ReminderMinuteOptions}"
                                      SelectedItem="{Binding NewReminderMinutesBefore}"
                                      IsEnabled="{Binding NewIsReminderEnabled}"
                                      Width="100" />

                            <TextBlock Text="분 전 알림"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <WrapPanel HorizontalAlignment="Right">

                            <Button Content="완료"
                                    Command="{Binding MarkAsCompletedCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEditMode}"
                                                               Value="True" />

                                                    <Condition Binding="{Binding IsEditingCompleted}"
                                                               Value="False" />
                                                </MultiDataTrigger.Conditions>

                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="완료 취소"
                                    Command="{Binding MarkAsIncompleteCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEditMode}"
                                                               Value="True" />

                                                    <Condition Binding="{Binding IsEditingCompleted}"
                                                               Value="True" />
                                                </MultiDataTrigger.Conditions>

                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="삭제"
                                    Command="{Binding DeleteScheduleCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="취소"
                                    Command="{Binding CancelEditCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,0" />

                            <Button Content="저장"
                                    Command="{Binding SaveScheduleCommand}"
                                    Padding="12,6" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>